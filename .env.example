# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase project — supabase.com/dashboard (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Langfuse Cloud — Project Settings > API Keys. Tracing is optional: the
# pipeline runs untraced if these are unset (see invoice_agent/tracing.py).
# LANGFUSE_HOST defaults to https://cloud.langfuse.com (EU region) if unset
# - set it explicitly if your project is on the US region instead
# (https://us.cloud.langfuse.com). See docs/observability.md.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# Only needed for the Next.js detail view's "View trace" link (Phase 9D) -
# Project Settings > General > Project ID. Tracing itself works without it;
# this just can't build a trace URL without knowing which project it's in.
# LANGFUSE_PROJECT_ID=cl_your-project-id-here

# Gmail ingestion (Phase 5, invoice_agent/mcp_servers/gmail_imap.py) — IMAP
# + App Password, not OAuth. Requires 2FA enabled on the account. Generate
# at https://myaccount.google.com/apppasswords. See docs/mcp_setup.md.
GMAIL_ADDRESS=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# FastAPI backend (Phase 8, app/) — all optional, each already has a
# sensible default in code if unset. See docs/api.md.
# MAX_UPLOAD_BYTES=20971520
# UPLOAD_DIR=uploads
# CHECKPOINT_DB_PATH=checkpoints/graph.sqlite
# GRAPH_MAX_CONCURRENCY=2

# Auth (app/auth.py) - FastAPI verifies Supabase access tokens against
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json (asymmetric signing keys)
# and allows only these users. Unset OWNER_USER_ID = every request is 403.
OWNER_USER_ID=your-supabase-user-uuid
# ALLOWED_USER_IDS=another-uuid,yet-another-uuid
# Dev/test only: skips token verification and acts as OWNER_USER_ID. Never in production.
# AUTH_DISABLED=true

# Next.js frontend (Verity, web/) - configured by its own variables, not this
# file: see web/.env.example. It never reads ANTHROPIC_API_KEY, SUPABASE_KEY
# or GMAIL_*; the browser reaches this backend only through web's /api proxy.
