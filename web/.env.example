# Copy to .env.local for local dev. In production these are runtime env vars
# (read per request, never baked into the image) - see deploy/aws.md.

# Supabase Auth (Project Settings > API). The *publishable* key only - the
# frontend never holds a service-role/secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Who may sign in: the owner's Supabase user id (Authentication > Users),
# plus optional extra ids. Must match the backend's values. Unset = nobody.
OWNER_USER_ID=
# ALLOWED_USER_IDS=

# Where the Next.js server reaches FastAPI. The browser never does: it only
# calls this app's own /api proxy. Defaults to http://127.0.0.1:8000.
# Under Docker Compose: http://backend:8000
# API_INTERNAL_URL=http://127.0.0.1:8000

# Public origin used for the OAuth redirect (behind nginx, request.url is
# the container's address). Defaults to the request's own origin locally.
# SITE_URL=https://verity.example.com
