# Base URL of the FastAPI backend (see ../docs/api.md). Must be reachable
# from the browser, not just this Next.js server - it's read via
# NEXT_PUBLIC_ so it's inlined into client-side JS at build time.
# Defaults to http://127.0.0.1:8000 if unset (lib/config.ts), matching
# `uvicorn app.main:app --reload`'s default port.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
