# Backend URLs for the Next.js frontend (see ../docs/api.md). All optional
# for local dev - with none set, everything defaults to
# http://127.0.0.1:8000, matching `uvicorn app.main:app --reload`.
#
# Copy to .env.local to override.

# What the *browser* calls: client-side fetches, the SSE stream, the CSV
# download link. Read at request time, so one prebuilt image can serve any
# deployment. The backend's CORS_ALLOW_ORIGINS must include this app's own
# origin.
# API_PUBLIC_URL=http://localhost:8000

# What the Next.js *server* calls (the home page's recent-runs list). Only
# needed when that differs from API_PUBLIC_URL - e.g. under Docker Compose,
# where the browser uses localhost:8000 but this server uses backend:8000.
# Defaults to API_PUBLIC_URL.
# API_INTERNAL_URL=http://backend:8000

# Build-time alternative to API_PUBLIC_URL (inlined into client JS by
# `next build`, so it can't vary per deployment). Fallback only.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
