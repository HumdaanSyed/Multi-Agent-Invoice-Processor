# /etc/verity/config.env - NON-secret settings only (root:root, 0644 is fine).
# Secrets go in AWS Secrets Manager, never here. See deploy/ec2.md.

# Image source and version. Pin a commit SHA (CI tags every push with
# ${{ github.sha }}); rolling back = changing this line and restarting.
GHCR_OWNER=humdaansyed
IMAGE_TAG=replace-with-a-commit-sha

# Read by fetch-secrets.sh
AWS_REGION=us-east-1
SECRET_ID=verity/prod
# Read by backup.sh (S3 bucket for nightly checkpoint backups)
BACKUP_BUCKET=your-verity-backups-bucket

# Public origin (OAuth redirects) - must match Supabase's redirect allowlist.
SITE_URL=https://verity.example.com

# Supabase (public values: the URL and the *publishable* key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Who may use the app (Supabase Authentication > Users > your UID)
OWNER_USER_ID=your-supabase-user-uuid
# ALLOWED_USER_IDS=

# Backend tuning (optional)
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# GRAPH_MAX_CONCURRENCY=2
# MAX_UPLOAD_BYTES=20971520
