{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:verity/prod-*"
    },
    {
      "Sid": "WriteBackups",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::BACKUP_BUCKET/checkpoints/*"
    },
    {
      "Sid": "ReadBackupsForRestore",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::BACKUP_BUCKET", "arn:aws:s3:::BACKUP_BUCKET/checkpoints/*"]
    }
  ]
}
